<%- include('../partials/header') %>

<!-- BANNER SLIDER -->
<% if (banners && banners.length > 0) { %>
<section class="banner-slider" id="bannerSlider">
  <% banners.forEach((banner, i) => { %>
  <div class="banner-slide <%= i === 0 ? 'active' : '' %>" style="<%= banner.image_url ? `background-image:url('${banner.image_url}')` : 'background:#1a1a1a' %>">
    <div class="banner-overlay"></div>
    <div class="banner-content">
      <% if (banner.title) { %><h2><%= banner.title %></h2><% } %>
      <% if (banner.subtitle) { %><p><%= banner.subtitle %></p><% } %>
      <% if (banner.link) { %><a href="<%= banner.link %>" class="btn btn-primary btn-lg">Ver Oferta</a><% } %>
    </div>
  </div>
  <% }) %>
  <% if (banners.length > 1) { %>
  <button class="slider-btn slider-prev" onclick="slideBanner(-1)"><i class="fas fa-chevron-left"></i></button>
  <button class="slider-btn slider-next" onclick="slideBanner(1)"><i class="fas fa-chevron-right"></i></button>
  <div class="slider-dots">
    <% banners.forEach((b, i) => { %><span class="dot <%= i===0?'active':'' %>" onclick="goSlide(<%= i %>)"></span><% }) %>
  </div>
  <% } %>
</section>
<% } %>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-badge"><i class="fas fa-bolt"></i> Envío rápido a todo Colombia</div>
      <h1>Repuestos Automotrices<br><span>de Alta Calidad</span></h1>
      <p>Puedes cotizar todo tipo de repuesto por medio de nuestro whatssap. Marcas originales y alternativas para todos los vehículos. </p>
      <div class="hero-actions">
        <a href="/productos" class="btn btn-primary btn-lg">Ver Catálogo <i class="fas fa-arrow-right"></i></a>
        <a href="#marcas" class="btn btn-outline btn-lg">Explorar Marcas</a>
      </div>
      <div class="hero-stats">
        <div><strong>1K+</strong><span>Referencias</span></div>
        <div><strong>10+</strong><span>Marcas</span></div>
        <div><strong>24h</strong><span>Envío Express</span></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-glow"></div>
      <div class="hero-rings">
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
        <div class="ring ring-3"></div>
      </div>
      <div class="hero-icon-main"><i class="fas fa-cog fa-spin-slow"></i></div>
    </div>
  </div>
</section>

<!-- FEATURES BAR -->
<section class="features-bar">
  <div class="container">
    <div class="features-grid">
      <div class="feature-item">
        <i class="fas fa-shipping-fast"></i>
        <div><strong>Envios </strong><p>Entodo el territorio de colombia</p></div>
      </div>
      <div class="feature-item">
        <i class="fas fa-shield-alt"></i>
        <div><strong>Garantía Real</strong><p></p></div>
      </div>
      <div class="feature-item">
        <i class="fas fa-check-double"></i>
        <div><strong>100% Original</strong><p>Piezas certificadas</p></div>
      </div>
      <div class="feature-item">
        <i class="fas fa-headset"></i>
        <div><strong>Soporte 24/7</strong><p>Asesoría técnica</p></div>
      </div>
    </div>
  </div>
</section>

<!-- BRANDS -->
<section class="section" id="marcas">
  <div class="container">
    <div class="section-header">
      <h2>Marcas</h2>
      <a href="/productos" class="link-all">Ver todo <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="categories-grid">
      <% (brands && brands.length > 0 ? brands : [
        {name:'Bosch',   slug:'bosch'},
        {name:'NGK',     slug:'ngk'},
        {name:'Gates',   slug:'gates'},
        {name:'Denso',   slug:'denso'},
        {name:'Mann',    slug:'mann'},
        {name:'Brembo',  slug:'brembo'},
        {name:'Monroe',  slug:'monroe'},
        {name:'Valeo',   slug:'valeo'}
      ]).forEach(brand => { %>
      <a href="/productos?marca=<%= brand.slug %>" class="category-card">
        <% if (brand.logo_url) { %>
        <div class="cat-icon"><img src="<%= brand.logo_url %>" alt="<%= brand.name %>" style="max-height:40px;object-fit:contain;"></div>
        <% } else { %>
        <div class="cat-icon">🔩</div>
        <% } %>
        <div class="cat-name"><%= brand.name %></div>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="section section-dark">
  <div class="container">
    <div class="section-header">
      <h2>Productos Destacados</h2>
      <a href="/productos" class="link-all">Ver más <i class="fas fa-arrow-right"></i></a>
    </div>
    <% if (featured.length > 0) { %>
    <div class="products-grid">
      <%- include('../partials/product-cards', { products: featured }) %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <h3>Próximamente</h3>
      <p>Más productos disponibles muy pronto</p>
      <% if (user && user.role === 'admin') { %>
      <a href="https://wa.me/57<%= process.env.WHATSAPP_NUMBER || '3152411837' %>" target="_blank" rel="noopener">
    <i class="fab fa-whatsapp"></i>
    <span class="whatsapp-text">¿Necesitas ayuda?</span>
  </a>
      <% } %>
    </div>
    <% } %>
  </div>
</section>



<!-- CTA BANNER -->
<section class="cta-banner">
  <div class="container">
    <div class="cta-content">
      <h2>¿Necesitas asesoría técnica?</h2>
      <p>Nuestros expertos te ayudan a encontrar el repuesto correcto para tu vehículo</p>
      <a href="https://wa.me/57<%= process.env.WHATSAPP_NUMBER || '3152411837' %>"
         class="btn btn-whatsapp btn-lg"
         target="_blank"
         rel="noopener">
        <i class="fab fa-whatsapp"></i> Chatear por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
let currentSlide = 0;
const slides = document.querySelectorAll('.banner-slide');
const dots   = document.querySelectorAll('.dot');

function goSlide(n) {
  if (!slides.length) return;
  slides[currentSlide].classList.remove('active');
  dots[currentSlide]?.classList.remove('active');
  currentSlide = (n + slides.length) % slides.length;
  slides[currentSlide].classList.add('active');
  dots[currentSlide]?.classList.add('active');
}

function slideBanner(dir) { goSlide(currentSlide + dir); }

if (slides.length > 1) setInterval(() => slideBanner(1), 5000);
</script>

<%- include('../partials/footer') %>
